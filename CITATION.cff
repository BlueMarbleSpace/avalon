title: "AVALON: Albedo-feedback Variable Axial-tilt Latitudinal Outgoing-Net EBM"
authors:
  - family-names: "Haqq-Misra"
    given-names: "Jacob"
    orcid: "https://orcid.org/0000-0003-4346-2611"
